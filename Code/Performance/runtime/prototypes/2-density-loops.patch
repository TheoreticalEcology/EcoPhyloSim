+// PROTOTYPE: disc offsets in the loop order used below; full includes (0, 0), noSelf excludes it
+void Landscape::buildOffsets() {
+    for (int positive = 0; positive <= 1; positive++) {
+        int cutoff = positive ? m_posCutoff : m_DensityCutoff;
+        m_offFull[positive].clear();
+        m_offNoSelf[positive].clear();
+        for (int X2 = -cutoff; X2 <= cutoff; X2++) {
+            int yl = floor(sqrt(cutoff * cutoff - X2 * X2));
+            for (int Y2 = -yl; Y2 <= yl; Y2++) {
+                m_offFull[positive].push_back(std::make_pair(X2, Y2));
+                if (X2 != 0 || Y2 != 0) m_offNoSelf[positive].push_back(std::make_pair(X2, Y2));
+            }
+        }
+        m_offOK[positive] = cutoff < m_Xdimensions && cutoff < m_Ydimensions;
+    }
+    m_offBuilt = true;
+}
+
+template <int KERNEL>
+static inline double dissimSum(Individual &ind, int x, int y, const std::vector<std::pair<int, int> > &off,
+                               Individual **grid, int X, int Y, double width) {
+    double sum = 0.0;
+    const double cm = ind.m_CompetitionMarker;
+    Species *sp = ind.m_Species;
+    for (const auto &o : off) {
+        int nx = x + o.first;  if (nx < 0) nx += X; else if (nx >= X) nx -= X;
+        int ny = y + o.second; if (ny < 0) ny += Y; else if (ny >= Y) ny -= Y;
+        Individual &neighbor = grid[nx][ny];
+        if (KERNEL == 1) sum += std::abs(cm - neighbor.m_CompetitionMarker);
+        else if (KERNEL == 2) sum += exp(-0.5 * pow(std::abs(cm - neighbor.m_CompetitionMarker) / width, 2.0));
+        else sum += (sp == neighbor.m_Species);
+    }
+    return sum;
+}
