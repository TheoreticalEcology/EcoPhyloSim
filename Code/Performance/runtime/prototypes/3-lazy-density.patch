+// PROTOTYPE 3: the stored densities are a function of the current neighbourhood; recompute them only when read
+void Landscape::recomputeDensity(int x, int y) {
+    Individual &ind = m_Individuals[x][y];
+    if (m_DD) ind.m_LocalDensity = localDissimilarity(ind, x, y, false);
+    if (m_pDD) ind.m_LocalPositive = localDissimilarity(ind, x, y, true);
+}
+
+void Landscape::ensureDensity(int x, int y) {
+    if (m_dirty.empty()) return;
+    char &d = m_dirty[x * m_Ydimensions + y];
+    if (d) { recomputeDensity(x, y); d = 0; }
+}
